
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["backend/src/**/*.ts"]
}
{
    "extends": "../tsconfig.json",
    "compilerOptions":{
        "rootDir": "..",
        "noEmit": true,
        "types": ["node", "vitest/globals"]
    },
    "include":["./**/*.ts"]
}
